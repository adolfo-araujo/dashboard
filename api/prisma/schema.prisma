generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  first_name              String                   @db.VarChar(50)
  last_name               String                   @db.VarChar(50)
  email                   String                   @unique @db.VarChar(100)
  password                String                   @db.VarChar(100)
  email_verified_at       DateTime?
  terms_accepted_at       DateTime?
  terms_version           String?                  @db.VarChar(20)
  transactions            Transaction[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  recurringTransactions   RecurringTransaction[]
  budgets                 Budget[]
}

model Transaction {
  id      String          @id @default(uuid())
  user_id String
  user    User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name    String          @db.VarChar(50)
  date    DateTime        @db.Date
  amount  Decimal         @db.Decimal(10, 2)
  type         TransactionType
  category     String?               @db.VarChar(30)
  recurring_id String?
  recurring    RecurringTransaction? @relation(fields: [recurring_id], references: [id], onDelete: SetNull)

  @@unique([recurring_id, date])
  @@index([user_id, date])
}

model RecurringTransaction {
  id              String          @id @default(uuid())
  user_id         String
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name            String          @db.VarChar(50)
  amount          Decimal         @db.Decimal(10, 2)
  type            TransactionType
  category        String?         @db.VarChar(30)
  day_of_month    Int
  start_date      DateTime        @db.Date
  end_date        DateTime?       @db.Date
  active          Boolean         @default(true)
  generated_until DateTime?       @db.Date
  created_at      DateTime        @default(now())
  transactions    Transaction[]

  @@index([user_id])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String    @unique @db.VarChar(64)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String    @unique @db.VarChar(64)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
}

model Budget {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category   String   @db.VarChar(30)
  amount     Decimal  @db.Decimal(10, 2)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, category])
}

enum TransactionType {
  EARNING
  EXPENSE
  INVESTMENT
}
