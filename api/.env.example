# Conexão com o PostgreSQL (o docker-compose da raiz sobe um banco nesse endereço)
DATABASE_URL="postgresql://postgres:password@localhost:5432/finance-app"

# Troque por valores longos e aleatórios em produção
JWT_ACCESS_TOKEN_SECRET="troque-este-segredo-de-acesso"
JWT_REFRESH_TOKEN_SECRET="troque-este-segredo-de-refresh"

PORT=8080

# Origens permitidas (separadas por vírgula). Vazio = qualquer origem.
# CORS_ORIGIN=http://localhost:5173
