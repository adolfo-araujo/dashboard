{
  "redirects": [
    {
      "source": "/login",
      "destination": "https://finance.valtrea.com.br/login",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "https://finance.valtrea.com.br/signup",
      "permanent": true
    },
    {
      "source": "/termos",
      "destination": "https://finance.valtrea.com.br/termos",
      "permanent": true
    },
    {
      "source": "/privacidade",
      "destination": "https://finance.valtrea.com.br/privacidade",
      "permanent": true
    },
    {
      "source": "/acessibilidade",
      "destination": "https://finance.valtrea.com.br/acessibilidade",
      "permanent": true
    },
    {
      "source": "/forgot-password",
      "destination": "https://finance.valtrea.com.br/forgot-password",
      "permanent": true
    },
    {
      "source": "/reset-password",
      "destination": "https://finance.valtrea.com.br/reset-password",
      "permanent": false
    },
    {
      "source": "/verify-email",
      "destination": "https://finance.valtrea.com.br/verify-email",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/lista-de-espera",
      "destination": "https://api.valtrea.com.br/api/lista-de-espera"
    },
    {
      "source": "/api/lista-de-espera/:acao",
      "destination": "https://api.valtrea.com.br/api/lista-de-espera/:acao"
    },
    {
      "source": "/en",
      "destination": "/index.html"
    },
    {
      "source": "/es",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=15552000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
